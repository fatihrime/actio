# Caddy is the stack's single entry point: http://localhost:8080 in development.
# /api/* and /v1/* go to the API; every other path goes to the web app.
{
	admin off
	auto_https off
}

:8080 {
	@api path /api/* /v1/*
	handle @api {
		# The largest request the API takes is a question of 100,000 characters
		# (MAX_QUESTION_CHARS), at most twelve bytes each as JSON: a character beyond
		# the first 65,536 written as two \u escapes. That is 1.2 MB and a little more.
		# A larger body is refused here: one that says its length before any of it is
		# passed on, and one sent in chunks once the limit is reached.
		# deploy/tests/test_compose_policy.py holds the two numbers together.
		request_body {
			max_size 2MB
		}
		# What the API answers as JSON goes out compressed, to a client that takes gzip:
		# a conversation is about three times smaller. Matched by the response's type, so
		# that nothing else is: an answer's stream (text/event-stream) passes as it is.
		# Compressed, every event that is passed on at once costs gzip a few bytes, and
		# each stream would hold a compressor for as long as its answer is written.
		# gzip alone: zstd held more of the proxy's memory, for JSON 5 to 6 % smaller. A
		# body under 512 bytes, Caddy's minimum, goes out as it is.
		# deploy/tests/test_compose_policy.py holds the match to the stream's media type.
		# See docs/adr/0004-local-development-stack.md, revision of 2026-11-22.
		encode gzip {
			match {
				header Content-Type application/json*
			}
		}
		reverse_proxy {$ACTIO_API_UPSTREAM} {
			flush_interval -1 # pass streamed tokens (server-sent events) through at once
		}
	}
	handle {
		reverse_proxy {$ACTIO_WEB_UPSTREAM} {
			flush_interval -1
		}
	}

	# Refused for its size: in the API's own error format, so that the page can say why,
	# and on the developer gateway, /v1/*, in OpenAI's, as every error there is, so that
	# the SDKs read it. Told apart by the matcher that sends /v1/* to the API, written
	# from the API's own rule for the gateway's paths (actio.api.problems): Caddy's also
	# takes other letters' case and a doubled slash, which no SDK sends.
	# deploy/tests/test_compose_policy.py holds the two forms.
	# See docs/adr/0034-the-gateway-answers-in-openais-form.md.
	handle_errors 413 {
		@gateway path /v1/*
		handle @gateway {
			header Content-Type application/json
			respond `{"error":{"message":"This is too much to send at once: Actio takes at most 2 MB in one request.","type":"invalid_request_error","param":null,"code":null}}` 413
		}
		handle {
			header Content-Type application/problem+json
			respond `{"type":"about:blank","title":"Content Too Large","status":413,"detail":"This is too much to send at once: Actio takes at most 2 MB in one request. Shorten the message, and send it again."}` 413
		}
	}
}

# Docker's health check calls this; it is reachable only inside the container.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond "ok"
}
