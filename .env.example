# Settings for the local stack. `make bootstrap` or `make dev` copies this file to
# .env and fills in random passwords. .env is git-ignored: never commit it.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# Host ports, all bound to 127.0.0.1. Uncomment and change one if it clashes.
# ACTIO_HTTP_PORT=8080
# ACTIO_POSTGRES_PORT=5432
# ACTIO_VALKEY_PORT=6379

# The address people open in their browser, if it isn't http://localhost:8080 (or the
# port above). The API accepts changes only from pages at this address, and over HTTPS
# it marks the session cookie Secure.
# ACTIO_PUBLIC_URL=https://chat.example.com

# Rate limits, written as a count per second, minute, hour or day. These are the
# defaults. "30/hour" allows 30 at once, then one more every two minutes.
# An address is an IPv4 address or an IPv6 /64 network, so everyone behind one router
# shares it. Raise the first for a classroom; lower it, to 3/day say, for a public demo.
# ACTIO_LIMIT_GUESTS_PER_ADDRESS=30/hour
# ACTIO_LIMIT_SIGNUPS_PER_ADDRESS=10/hour
# ACTIO_LIMIT_LOGINS_PER_ADDRESS=30/hour
# Password attempts for one account, from anywhere:
# ACTIO_LIMIT_LOGINS_PER_EMAIL=10/hour
