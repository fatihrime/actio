# Settings for the local stack. `make bootstrap` or `make dev` copies this file to
# .env and fills in random passwords. .env is git-ignored: never commit it.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# Host ports, all bound to 127.0.0.1. Uncomment and change one if it clashes.
# ACTIO_HTTP_PORT=8080
# ACTIO_POSTGRES_PORT=5432
# ACTIO_VALKEY_PORT=6379

# The address people open in their browser, if it isn't http://localhost:8080 (or the
# port above). The API accepts changes only from pages at this address, and over HTTPS
# it marks the session cookie Secure.
# ACTIO_PUBLIC_URL=https://chat.example.com

# Where Ollama is, as seen from the API. Leave it out when Ollama runs on this machine:
# `make up` then reaches it as http://host.docker.internal:11434, and `make dev` as
# http://127.0.0.1:11434. Which models are offered is in config/models.toml.
# ACTIO_OLLAMA_URL=http://192.168.1.50:11434

# Rate limits, written as a count per second, minute, hour or day. These are the
# defaults. "30/hour" allows 30 at once, then one more every two minutes.
# An address is an IPv4 address or an IPv6 /64 network, so everyone behind one router
# shares it. Raise the first for a classroom; lower it, to 3/day say, for a public demo.
# ACTIO_LIMIT_GUESTS_PER_ADDRESS=30/hour
# ACTIO_LIMIT_SIGNUPS_PER_ADDRESS=10/hour
# ACTIO_LIMIT_LOGINS_PER_ADDRESS=30/hour
# Password attempts for one account, from anywhere:
# ACTIO_LIMIT_LOGINS_PER_EMAIL=10/hour
# Messages one account, a guest included, may send to a model:
# ACTIO_LIMIT_TURNS_PER_USER=120/hour
# Requests one account may make to have a model loaded before its first question. The
# page makes one a minute at most, in each tab:
# ACTIO_LIMIT_WARM_UPS_PER_USER=120/hour

# What a model's answers cost, and how many credits a session and a week allow, is not
# set here: see config/plans.toml.

# Keys for the free tiers of two cloud providers, which Actio is to send answers to
# beside Ollama. Today only `make preflight` reads them: it checks what each key's
# account may use, and asks each model it checks one short question, which counts
# against that account's limits. A Groq key is made at https://console.groq.com/keys,
# and a Gemini API key at https://aistudio.google.com/apikey.
# GROQ_API_KEY=
# GEMINI_API_KEY=
