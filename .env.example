# Settings for the local stack. `make bootstrap` or `make dev` copies this file to
# .env and fills in random passwords. .env is git-ignored: never commit it.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# Host ports, all bound to 127.0.0.1. Uncomment and change one if it clashes.
# ACTIO_HTTP_PORT=8080
# ACTIO_POSTGRES_PORT=5432
# ACTIO_VALKEY_PORT=6379
