{
  "method": "POST",
  "path": "/v1beta/openai/chat/completions",
  "request": {
    "model": "gemini-3.5-flash-lite",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful assistant. Answer briefly."
      },
      {
        "role": "user",
        "content": "What is the capital of France? Answer in one short sentence."
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "max_completion_tokens": 512
  },
  "status": 400,
  "content_type": "application/json; charset=UTF-8",
  "body": "[{\n  \"error\": {\n    \"code\": 400,\n    \"message\": \"Please pass a valid API key\",\n    \"status\": \"INVALID_ARGUMENT\"\n  }\n}\n]"
}
