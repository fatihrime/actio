{
  "method": "POST",
  "path": "/openai/v1/chat/completions",
  "request": {
    "model": "openai/gpt-oss-120b",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful assistant. Answer briefly."
      },
      {
        "role": "user",
        "content": "What is the capital of France? Answer in one short sentence."
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "max_completion_tokens": 512,
    "reasoning_effort": "none"
  },
  "status": 400,
  "content_type": "application/json",
  "body": "{\"error\":{\"message\":\"`reasoning_effort` must be one of `low`, `medium`, or `high`\",\"type\":\"invalid_request_error\"}}\n"
}
